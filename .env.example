# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FIREBASE_API_KEY: Optional. Setup for real-time Firebase Sync.
FIREBASE_API_KEY=
# FIREBASE_PROJECT_ID: Optional. Setup for real-time Firebase Sync.
FIREBASE_PROJECT_ID=
# FIREBASE_APPLICATION_ID: Optional. Setup for real-time Firebase Sync.
FIREBASE_APPLICATION_ID=
# FIREBASE_DATABASE_URL: Optional. Setup for real-time Firebase Sync.
FIREBASE_DATABASE_URL=
