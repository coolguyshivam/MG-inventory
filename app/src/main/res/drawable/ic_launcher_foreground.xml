<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Group to ensure all layers scale beautifully and reside safely in the 66dp center -->
    <group>
        
        <!-- STEP 1: CONCENTRIC NEON RING BORDER (Matches the circular ring logo) -->
        <!-- Outer soft ambient magenta aura -->
        <path
            android:pathData="M 54,23 A 31,31 0 1,1 53.9,23 Z"
            android:strokeWidth="8"
            android:strokeColor="#1AFF0099"
            android:strokeLineCap="round" />
        
        <!-- Middle electric purple-pink glow -->
        <path
            android:pathData="M 54,23 A 31,31 0 1,1 53.9,23 Z"
            android:strokeWidth="3.5"
            android:strokeColor="#80EE1297"
            android:strokeLineCap="round" />
        
        <!-- Inner sharp white-pink neon core segment -->
        <path
            android:pathData="M 54,23 A 31,31 0 1,1 53.9,23 Z"
            android:strokeWidth="1.2"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />


        <!-- STEP 2: SLEEK SMARTPHONE SILHOUETTE (Represents "Mobile Shop / Gallery") -->
        <!-- Outer bezel body -->
        <path
            android:pathData="M 47,35 H 61 A 3.5,3.5 0 0,1 64.5,38.5 V 69.5 A 3.5,3.5 0 0,1 61,73 H 47 A 3.5,3.5 0 0,1 43.5,69.5 V 38.5 A 3.5,3.5 0 0,1 47,35 Z"
            android:fillColor="#15132B"
            android:strokeWidth="1.6"
            android:strokeColor="#FFC1E3F6" />

        <!-- Camera punch-hole lens -->
        <path
            android:pathData="M 54,38 A 0.8,0.8 0 1,1 53.9,38 Z"
            android:fillColor="#FFC1E3F6" />

        <!-- Screen vertical sheen/reflection (Diagonal slash across smartphone) -->
        <path
            android:pathData="M 62,43 L 46,59"
            android:strokeWidth="1"
            android:strokeColor="#18FFFFFF" />

        <!-- Home touch bar indicator -->
        <path
            android:pathData="M 50,71.2 H 58"
            android:strokeWidth="0.8"
            android:strokeColor="#475569"
            android:strokeLineCap="round" />


        <!-- STEP 3: BOLD HIGH-CONTRAST GRADIENT "M" (Main brand element) -->
        <!-- Backing deep glow for the M Letter -->
        <path
            android:pathData="M 35,66 L 35,44 L 54,58 L 73,44 L 73,66"
            android:strokeWidth="8"
            android:strokeColor="#25FF007F"
            android:strokeLineJoin="round"
            android:strokeLineCap="round" />

        <!-- Primary gradient thick vector path -->
        <path
            android:pathData="M 35,66 L 35,44 L 54,58 L 73,44 L 73,66"
            android:strokeWidth="5.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="35"
                    android:startY="44"
                    android:endX="73"
                    android:endY="66">
                    <item android:offset="0" android:color="#FFFF007F" />     <!-- High-impact Neon Pink -->
                    <item android:offset="0.55" android:color="#FFEC4899" />  <!-- Hot Pink and Magenta -->
                    <item android:offset="1" android:color="#FFAC24F4" />     <!-- Electric Orchid Violet -->
                </gradient>
            </aapt:attr>
        </path>

        <!-- White lightning neon filament overlay inside the M -->
        <path
            android:pathData="M 35,66 L 35,44 L 54,58 L 73,44 L 73,66"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round" />

    </group>
</vector>
